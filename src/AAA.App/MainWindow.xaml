<Window x:Class="AAA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAA Game Builder – No Code"
        Height="680" Width="900" MinHeight="480" MinWidth="640"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="56"/>
            <!-- Chat area -->
            <RowDefinition Height="*"/>
            <!-- Input area -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎮" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AAA Game Builder – No Code"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Opisz swoją grę po polsku, a ja ją zaprojektuję"
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Content="🗑 Nowa sesja" Style="{StaticResource SendButtonStyle}"
                            Background="#37474F" FontSize="12" Padding="10,6"
                            Click="NowaSesja_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat scrollview -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,8"
                      Background="{StaticResource BackgroundBrush}">
            <ItemsControl x:Name="ChatItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <!-- User message – aligned right -->
                            <Border Style="{StaticResource ChatBubbleBase}"
                                    Background="{StaticResource UserBubbleBrush}"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding UserVisibility}">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="White"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <!-- Bot message – aligned left -->
                            <Border Style="{StaticResource ChatBubbleBase}"
                                    Background="{StaticResource BotBubbleBrush}"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding BotVisibility}">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input area -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         Style="{StaticResource InputBoxStyle}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="100"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,8,0"
                         KeyDown="InputBox_KeyDown"
                         PlaceholderText="Opisz swoją grę… (Enter – wyślij, Shift+Enter – nowa linia)"/>
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Wyślij ▶"
                        Style="{StaticResource SendButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Wyslij_Click"/>
                <Button x:Name="ApproveButton"
                        Grid.Column="2"
                        Content="✔ Zatwierdź GDD"
                        Style="{StaticResource SendButtonStyle}"
                        Background="#2E7D32"
                        Visibility="Collapsed"
                        Click="Zatwierdz_Click"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}">
            <TextBlock x:Name="StatusBar"
                       Text="Gotowy"
                       Foreground="{StaticResource SubtextBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="14,0"/>
        </Border>
    </Grid>
</Window>
