<Window x:Class="AAA.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ Ustawienia LLM"
        Width="520" Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0"
                   Text="Konfiguracja modelu językowego (LLM)"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="15" FontWeight="Bold"/>

        <!-- Klucz API -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Klucz API:" Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ApiKeyBox"
                         Background="#0F3460" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                         FontSize="13" Padding="10,6"/>
        </StackPanel>

        <!-- Endpoint -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Adres endpoint:" Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="EndpointBox"
                     Style="{StaticResource InputBoxStyle}"
                     FontSize="13"/>
        </StackPanel>

        <!-- Model -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Model:" Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="ModelBox"
                     Style="{StaticResource InputBoxStyle}"
                     FontSize="13"/>
        </StackPanel>

        <!-- Info -->
        <TextBlock Grid.Row="8"
                   Text="Kompatybilne z OpenAI, Azure OpenAI oraz lokalnym Ollama (ustaw odpowiedni endpoint)."
                   Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" TextWrapping="Wrap"/>

        <!-- Przyciski -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton"
                    Content="🔌 Testuj połączenie"
                    Style="{StaticResource SendButtonStyle}"
                    Background="#37474F" FontSize="12" Padding="12,6" Margin="0,0,8,0"
                    Click="Test_Click"/>
            <Button Content="💾 Zapisz"
                    Style="{StaticResource SendButtonStyle}"
                    FontSize="12" Padding="12,6" Margin="0,0,8,0"
                    Click="Zapisz_Click"/>
            <Button Content="Anuluj"
                    Style="{StaticResource SendButtonStyle}"
                    Background="#263238" FontSize="12" Padding="12,6"
                    Click="Anuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>
